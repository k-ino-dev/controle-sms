# ==============================================================================
# Variables d'Environnement - Contrôle SMS
# ==============================================================================

# 1. Base de Données SQLite
# En production Docker (recommandé) :
DATABASE_URL="file:/app/data/dev.db"
# En développement local :
# DATABASE_URL="file:./dev.db"

# 2. Répertoires de Stockage Persistant (Volumes Docker)
UPLOADS_DIR="/app/data/uploads"
BACKUPS_DIR="/app/data/backups"

# 3. Sécurité & Sessions JWT (OBLIGATOIRE : clé aléatoire forte d'au moins 32 caractères)
# Générez une clé via : openssl rand -base64 32
JWT_SECRET="remplacez_par_un_vrai_secret_aleatoire_tres_long_de_32_caracteres_min"

# 4. Chiffrement de la Clé API WinSMS en Base (AES-256-GCM)
# Clé secrète de 32 caractères minimum pour chiffrer les identifiants sensibles en base
ENCRYPTION_KEY="votre_cle_secrete_de_chiffrement_aes256_32_caracteres_min"

# 5. Passerelle WinSMS Tunisie (winsmspro.com)
# Mode "winsms" pour les envois réels, "mock" pour le développement/simulation hors ligne
SMS_PROVIDER="mock"
WINSMS_API_KEY="votre_cle_api_secrete_winsms"
WINSMS_SENDER_ID="Lyc.Emtiyez"
WINSMS_API_URL="https://www.winsmspro.com/sms/sms/api"

# 6. Compte Directeur Initial (Créé lors du premier démarrage si inexistant)
# IMPORTANT : En production, INITIAL_DIRECTOR_PASSWORD ne peut pas être 'admin' ou vide.
INITIAL_DIRECTOR_USERNAME="directeur"
INITIAL_DIRECTOR_PASSWORD="VotreMotDePasseDirecteurFort2026!"

# 7. Domaine & Serveur
DOMAIN_NAME="ecole.votre-domaine.tn"
PORT=3000
NODE_ENV="production"
