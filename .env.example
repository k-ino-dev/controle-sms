# Base de données SQLite (un seul fichier .db, idéal pour archivage et sauvegardes faciles)
DATABASE_URL="file:./dev.db"

# Clé secrète pour le hachage et la signature des sessions JWT
JWT_SECRET="votre_secret_jwt_securise_aleatoire_64_caracteres"

# Configuration WinSMS Tunisie
# Mode "winsms" pour la production, "mock" pour le mode simulation locale sans consommation de crédits
SMS_PROVIDER="mock"
WINSMS_API_KEY="votre_cle_api_winsms"
WINSMS_SENDER_ID="ELIMTIAZ"
WINSMS_API_URL="https://api.winsms.tn/v1"

# Identifiants du compte Directeur créé lors du premier lancement (seed)
INITIAL_DIRECTOR_USERNAME="directeur"
INITIAL_DIRECTOR_PASSWORD="admin"

# Nom de domaine ou IP du VPS pour Caddy HTTPS automatique
DOMAIN_NAME="ecole.votre-domaine.tn"
PORT=3000
NODE_ENV="production"
